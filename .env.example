# Copy to .env for local development:  cp .env.example .env
# .env is git-ignored. Never commit real secrets. Production values come from a secrets manager.

# ---- Django
DJANGO_SETTINGS_MODULE=config.settings.development
# Production: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com
# DJANGO_ADMIN_URL=admin/
APP_ENVIRONMENT=development
API_DOCS_ENABLED=true

# ---- Database (see infrastructure/db/create_roles.sql)
# Local, outside Docker: tilltree_owner runs migrations and tests.
# Runtime in Docker/production: tilltree_app (no DDL, cannot bypass row-level security).
DB_NAME=tilltree
DB_USER=tilltree_owner
DB_PASSWORD=tilltree_owner_dev
DB_HOST=localhost
DB_PORT=5432
# DB_POOL=false                     # production default: true
# DB_STATEMENT_TIMEOUT_MS=5000      # 0 for the migration job
# DB_DISABLE_SERVER_SIDE_CURSORS=false  # true behind PgBouncer (transaction mode)

# Passwords used by docker-compose when it creates the roles
DB_OWNER_PASSWORD=tilltree_owner_dev
DB_APP_PASSWORD=tilltree_app_dev

# ---- Redis / Celery (leave unset locally to use an in-memory cache and inline tasks)
# REDIS_CACHE_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/1

# ---- CORS: front-end origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Observability
LOG_LEVEL=INFO
LOG_JSON=false
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0
# APP_RELEASE=
