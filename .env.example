# Copy to .env and adjust:   cp .env.example .env
# .env is git-ignored. Never commit real secrets.

# Generate for production:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=dev-only-key-change-before-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev

# Front-end origins allowed to call the API (React dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database: "postgres" (default) or "sqlite" for a quick try without Postgres
DB_ENGINE=postgres
# Must match docker-compose.yml
POSTGRES_DB=commerce_platform
POSTGRES_USER=commerce
POSTGRES_PASSWORD=localdevonly
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
