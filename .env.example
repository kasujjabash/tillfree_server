# Copy to .env for local development:  cp .env.example .env
# .env is git-ignored. Never commit real secrets. Production values come from a secrets manager.

# ---- Django
DJANGO_SETTINGS_MODULE=config.settings.development
# Production: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com
# DJANGO_ADMIN_URL=admin/
APP_ENVIRONMENT=development
API_DOCS_ENABLED=true

# ---- Database (see infrastructure/db/create_roles.sql)
# Local, outside Docker: tillfree_owner runs migrations and tests.
# Runtime in Docker/production: tillfree_app (no DDL, cannot bypass row-level security).
DB_NAME=tillfree
DB_USER=tillfree_owner
DB_PASSWORD=tillfree_owner_dev
DB_HOST=localhost
DB_PORT=5432
# DB_POOL=false                     # production default: true
# DB_STATEMENT_TIMEOUT_MS=5000      # 0 for the migration job
# DB_DISABLE_SERVER_SIDE_CURSORS=false  # true behind PgBouncer (transaction mode)

# Passwords used by docker-compose when it creates the roles
DB_OWNER_PASSWORD=tillfree_owner_dev
DB_APP_PASSWORD=tillfree_app_dev

# ---- Authentication (docs/architecture/adr/0004-authentication-tokens.md)
# Leave empty in development: keys are derived from DJANGO_SECRET_KEY.
# Production (required):
#   JWT_SIGNING_KEYS="k1:<random 48+ chars>"      (first signs; add k2 first to rotate)
#     python -c "import secrets; print('k1:' + secrets.token_urlsafe(48))"
#   FIELD_ENCRYPTION_KEYS="<fernet key>"          (encrypts TOTP secrets; first encrypts)
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JWT_SIGNING_KEYS=
FIELD_ENCRYPTION_KEYS=
# ACCESS_TOKEN_LIFETIME_SECONDS=600
# REFRESH_TOKEN_SLIDING_SECONDS=2592000
# REFRESH_TOKEN_ABSOLUTE_SECONDS=7776000

# ---- Email (development prints emails to the console; Docker uses Mailpit at :8025)
FRONTEND_URL=http://localhost:5173
DEFAULT_FROM_EMAIL=Tillfree <no-reply@localhost>
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true

# ---- Redis / Celery (leave unset locally to use an in-memory cache and inline tasks)
# REDIS_CACHE_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/1

# ---- CORS: front-end origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Observability
LOG_LEVEL=INFO
LOG_JSON=false
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0
# APP_RELEASE=
